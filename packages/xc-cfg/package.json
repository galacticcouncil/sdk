{
  "name": "@galacticcouncil/xc-cfg",
  "version": "2.0.0",
  "description": "Cross-chain hydradx & basilisk dapp configuration",
  "author": "GalacticCouncil",
  "repository": {
    "directory": "packages/xc-cfg",
    "type": "git",
    "url": "git+https://github.com/galacticcouncil/sdk.git"
  },
  "keywords": [
    "hydration",
    "basilisk",
    "xcm"
  ],
  "bugs": {
    "url": "https://github.com/galacticcouncil/sdk/issues"
  },
  "files": [
    "build"
  ],
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "scripts": {
    "build": "npm run clean && node ./esbuild.dist.mjs",
    "build:watch": "node ./esbuild.dev.mjs",
    "postbuild": "tsc --emitDeclarationOnly --outDir build",
    "clean": "rimraf build",
    "link": "npm ln",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --silent"
  },
  "dependencies": {
    "@galacticcouncil/xc-core": "^2.0.0",
    "@thi.ng/memoize": "^4.0.2"
  },
  "peerDependencies": {
    "@galacticcouncil/common": ">=1.0.0",
    "@galacticcouncil/descriptors": ">=2.2.0",
    "@galacticcouncil/sdk-next": ">=1.5.0",
    "polkadot-api": "^2.1.7",
    "viem": "^2.38.3"
  }
}
