{
  "name": "@galacticcouncil/xc-sdk",
  "version": "2.0.0",
  "description": "Cross-chain sdk",
  "author": "GalacticCouncil",
  "type": "module",
  "repository": {
    "directory": "packages/xc-sdk",
    "type": "git",
    "url": "git+https://github.com/galacticcouncil/sdk.git"
  },
  "keywords": [
    "evm",
    "substrate",
    "wallet",
    "xcm",
    "wormhole"
  ],
  "bugs": {
    "url": "https://github.com/galacticcouncil/sdk/issues"
  },
  "files": [
    "build"
  ],
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "scripts": {
    "build": "npm run clean && node ./esbuild.dist.mjs",
    "build:watch": "node ./esbuild.dev.mjs",
    "postbuild": "tsc --emitDeclarationOnly --outDir build",
    "clean": "rimraf build",
    "link": "npm ln",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --silent"
  },
  "dependencies": {
    "@galacticcouncil/xc-core": "^2.0.0",
    "@mysten/bcs": "^1.9.2",
    "@mysten/sui": "^1.21.2",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.95.8",
    "@wormhole-foundation/sdk-base": "6.1.4",
    "@wormhole-foundation/sdk-definitions": "6.1.4",
    "@wormhole-foundation/sdk-definitions-ntt": "7.2.0",
    "@wormhole-foundation/sdk-solana": "6.1.4",
    "@wormhole-foundation/sdk-solana-core": "6.1.4",
    "@wormhole-foundation/sdk-solana-ntt": "7.2.0",
    "big.js": "^6.2.1",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@galacticcouncil/common": ">=1.0.0",
    "@galacticcouncil/descriptors": ">=2.0.0",
    "polkadot-api": "^2.1.7",
    "rxjs": "^7.8.0",
    "viem": "^2.38.3"
  }
}
